<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Agendamento CCN Plus</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f7fb;color:#172033}
header{background:linear-gradient(135deg,#071b49,#087bdc);color:#fff;padding:24px;text-align:center}
header h1{margin:0 0 6px}header p{margin:0}.container{max-width:900px;margin:25px auto;padding:0 15px}
.card{background:#fff;border-radius:16px;padding:22px;box-shadow:0 5px 22px #0001;margin-bottom:20px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}label{font-weight:bold;font-size:14px}
input,button{width:100%;padding:13px;border-radius:10px;border:1px solid #ccd5e2;font-size:15px;margin-top:6px}
button{background:#087bdc;color:#fff;border:0;font-weight:bold;cursor:pointer}.secondary{background:#eef3f9;color:#172033}
.tabs{display:flex;gap:10px;margin-bottom:20px}.tabs button{flex:1}.slots{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px}
.slot{background:#eaf5ff;color:#075da8;border:1px solid #b9ddfa}.slot.selected{background:#087bdc;color:#fff}.slot.busy{background:#e5e7eb;color:#8a8f98}
.msg{padding:12px;border-radius:10px;margin-top:14px;display:block}.ok{background:#e8f8ee;color:#146b35}.err{background:#fdecec;color:#a32626}
.hidden{display:none}.muted{color:#667085;font-size:13px}.counter{font-size:18px;font-weight:bold;margin-bottom:15px}
table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #e5e9ef;text-align:left}
.badge{padding:5px 9px;border-radius:20px;background:#e8f5ff;color:#075da8;font-size:12px;font-weight:bold}
@media(max-width:650px){.grid{grid-template-columns:1fr}.slots{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<header><h1>CCN Plus</h1><p>Agendamento de Atendimento</p></header>
<div class="container">
<div class="tabs"><button onclick="show('customer')">Agendamento</button><button class="secondary" onclick="show('admin')">Área do Administrador</button></div>

<section id="customer">
<div class="card">
<h2>Agende seu atendimento</h2>
<p class="muted">Escolha a data e um horário disponível. Os nomes dos demais clientes não são exibidos.</p>
<div class="grid">
<div><label>Nome completo</label><input id="nome" placeholder="Digite seu nome completo"></div>
<div><label>Data</label><input id="data" type="date"></div>
</div>
<label style="display:block;margin-top:16px">Horário</label>
<div id="slots" class="slots"></div>
<button id="agendarBtn" style="margin-top:18px" onclick="agendar()">Confirmar agendamento</button>
<div id="customerMsg" class="msg hidden"></div>
</div>
</section>

<section id="admin" class="hidden">
<div class="card" id="loginCard">
<h2>Área do Administrador</h2><p class="muted">Acesso exclusivo.</p>
<label>E-mail</label><input id="adminEmail" type="email">
<label style="display:block;margin-top:12px">Senha</label><input id="adminPassword" type="password">
<button style="margin-top:16px" onclick="loginAdmin()">Entrar</button>
<div id="adminMsg" class="msg hidden"></div>
</div>
<div class="card hidden" id="dashboard">
<div class="counter" id="counter"></div><button class="secondary" onclick="carregarAdmin()">Atualizar lista</button>
<div style="overflow:auto;margin-top:15px"><table><thead><tr><th>Nome</th><th>Data</th><th>Horário</th><th>Status</th></tr></thead><tbody id="adminBody"></tbody></table></div>
<button style="margin-top:16px" onclick="logoutAdmin()">Sair</button>
</div>
</section>
</div>

<script>
const URL="https://jrkkvrnifebhaligiood.supabase.co";
const KEY="sb_publishable_n1l3VywvtvU7dOuXXDUAIA_TptK0CAi";
const sb=supabase.createClient(URL,KEY);
const HORARIOS=["08:00","09:00","10:00","14:00","15:00","16:00","17:00"];
let selecionado=null;

function show(x){document.getElementById("customer").classList.toggle("hidden",x!=="customer");document.getElementById("admin").classList.toggle("hidden",x!=="admin")}
function msg(id,t,ok=false){const e=document.getElementById(id);e.textContent=t;e.className="msg "+(ok?"ok":"err")}
function iso(){const d=new Date(),o=d.getTimezoneOffset();return new Date(d-o*60000).toISOString().slice(0,10)}
function br(d){const p=d.split("-");return p[2]+"/"+p[1]+"/"+p[0]}
document.getElementById("data").min=iso();
document.getElementById("data").addEventListener("change",carregarHorarios);

async function carregarHorarios(){
 selecionado=null;const d=document.getElementById("data").value,b=document.getElementById("slots");b.innerHTML="";if(!d)return;
 const r=await sb.rpc("horarios_ocupados",{p_data:d});
 if(r.error){msg("customerMsg","Não foi possível consultar os horários.");return}
 const ocup=new Set((r.data||[]).map(x=>x.horario));
 HORARIOS.forEach(h=>{const x=document.createElement("button");x.type="button";x.className="slot "+(ocup.has(h)?"busy":"");x.textContent=h.replace(":","h");
 if(ocup.has(h))x.disabled=true;else x.onclick=()=>{document.querySelectorAll(".slot").forEach(z=>z.classList.remove("selected"));x.classList.add("selected");selecionado=h};b.appendChild(x)})
}
async function agendar(){
 const nome=document.getElementById("nome").value.trim(),d=document.getElementById("data").value;
 if(nome.length<3)return msg("customerMsg","Digite o nome completo.");
 if(!d)return msg("customerMsg","Escolha uma data.");
 if(!selecionado)return msg("customerMsg","Escolha um horário.");
 const btn=document.getElementById("agendarBtn");btn.disabled=true;btn.textContent="Agendando...";
 const r=await sb.from("agendamentos").insert({nome,data:d,horario:selecionado,status:"Agendado"});
 btn.disabled=false;btn.textContent="Confirmar agendamento";
 if(r.error){if(r.error.code==="23505")msg("customerMsg","Esse horário acabou de ser reservado. Escolha outro.");else msg("customerMsg","Não foi possível realizar o agendamento.");await carregarHorarios();return}
 msg("customerMsg","Agendamento confirmado: "+br(d)+" às "+selecionado.replace(":","h")+".",true);document.getElementById("nome").value="";await carregarHorarios()
}
async function loginAdmin(){
 const email=document.getElementById("adminEmail").value.trim(),password=document.getElementById("adminPassword").value;
 const r=await sb.auth.signInWithPassword({email,password});if(r.error)return msg("adminMsg","E-mail ou senha inválidos.");
 document.getElementById("loginCard").classList.add("hidden");document.getElementById("dashboard").classList.remove("hidden");carregarAdmin()
}
async function carregarAdmin(){
 const r=await sb.from("agendamentos").select("nome,data,horario,status").order("data").order("horario");
 if(r.error)return msg("adminMsg","O administrador ainda não tem permissão para consultar os agendamentos.");
 document.getElementById("counter").textContent=r.data.length+" de 19 agendamentos";
 document.getElementById("adminBody").innerHTML=r.data.map(x=>"<tr><td>"+esc(x.nome)+"</td><td>"+br(x.data)+"</td><td>"+x.horario.replace(":","h")+"</td><td><span class='badge'>"+esc(x.status||"Agendado")+"</span></td></tr>").join("")
}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
async function logoutAdmin(){await sb.auth.signOut();document.getElementById("dashboard").classList.add("hidden");document.getElementById("loginCard").classList.remove("hidden")}
async function verificarRecuperacao() {
  const hash = window.location.hash;
  const params = new URLSearchParams(hash.replace(/^#/, ""));
  const tipo = params.get("type");
  const accessToken = params.get("access_token");
  const refreshToken = params.get("refresh_token");

  if (tipo === "recovery" && accessToken && refreshToken) {
    const { error: sessionError } = await sb.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken
    });

    if (sessionError) {
      alert("Link inválido ou expirado. Solicite outro e-mail.");
      return;
    }

    const novaSenha = prompt("Digite sua nova senha (mínimo 6 caracteres):");

    if (novaSenha === null) return;

    if (novaSenha.length < 6) {
      alert("A senha deve ter pelo menos 6 caracteres.");
      return;
    }

    const { error } = await sb.auth.updateUser({
      password: novaSenha
    });

    if (error) {
      alert("Erro ao alterar a senha: " + error.message);
    } else {
      alert("Senha alterada com sucesso! Faça login com a nova senha.");
      window.location.href =
        "https://asdlucas2013-bot.github.io/agendamento-ccn-plus/";
    }
  }
}

verificarRecuperacao();
</script>
</body>
</html>
